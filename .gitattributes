# Line endings that work on each system, whatever git settings the uploader has.
*.bat      text eol=crlf
*.command  text eol=lf
*.py       text eol=lf
*.md       text eol=lf
*.html     text eol=lf
*.pyw      text eol=lf
*.iss      text eol=crlf
*.png      binary
*.ico      binary
*.icns     binary
